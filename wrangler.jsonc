{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donordrive-obs-dashboard",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Custom TanStack Start server entry; it also exports the DockChannel Durable Object
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "DOCK_CHANNEL", "class_name": "DockChannel" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DockChannel"] }],
  // Settings used by `wrangler preview`; bindings are not inherited from the top level
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "DOCK_CHANNEL", "class_name": "DockChannel" }],
    },
  },
}
